#### Transfer the reference clusters to Visium

```{r gbm-flex-transfer, message=FALSE}
shared_genes <- intersect(
  rownames(flex_ref[["RNA"]]),
  rownames(GBM[["Spatial"]])
)

anchor_features <- Reduce(intersect, list(
  shared_genes,
  VariableFeatures(flex_ref[["SCT"]]),
  rownames(GBM[["SCT"]])
))

cat("Shared count features:", length(shared_genes), "\n")
cat("SCT features for anchor finding:", length(anchor_features), "\n")

if (length(anchor_features) <= 30L) {
  stop("Check the shared gene symbols and SCT assays before mapping with 30 PCs.")
}

flex_anchors <- FindTransferAnchors(
  reference = flex_ref,
  query = GBM,
  normalization.method = "SCT",
  reference.assay = "SCT",
  query.assay = "SCT",
  features = anchor_features,
  dims = 1:30
)

flex_labels <- setNames(as.character(flex_ref$bc3_cluster), colnames(flex_ref))

GBM_flex <- GBM
GBM_flex[["flexscores"]] <- TransferData(
  anchorset = flex_anchors,
  refdata = flex_labels,
  prediction.assay = TRUE,
  weight.reduction = GBM[["pca"]],
  dims = 1:30
)
