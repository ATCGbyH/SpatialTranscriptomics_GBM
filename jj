download_bc3 <- function(suffix, destination) {
  if (file.exists(destination) && file.info(destination)$size > 0) {
    return(invisible(destination))
  }

  partial <- paste0(destination, ".part")
  on.exit(unlink(partial), add = TRUE)

  status <- utils::download.file(
    paste0(sample_url, suffix),
    destfile = partial,
    mode = "wb"
  )
  if (status != 0L || !file.rename(partial, destination)) {
    stop("Could not save the 10x file to ", destination)
  }

  invisible(destination)
}

download_bc3("_count_sample_filtered_feature_bc_matrix.h5", flex_h5)
